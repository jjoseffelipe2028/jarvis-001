# Jarvis 001 - modelo do arquivo .env (Ticket 033)
# 1) Copie este arquivo com o nome ".env" (na mesma pasta).
# 2) Preencha os valores. O ".env" NUNCA vai para o Git (esta no .gitignore).
# 3) Confira com:  python python/conferir.py
#
# Cada pessoa cria o seu. Nunca mande o seu .env para ninguem.

# --- Obrigatorias ---
# Token da API: um valor longo e aleatorio, so seu. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JARVIS_TOKEN=
# Pasta onde ficam as notas do dia (ex.: C:/Users/voce/Documentos/Cofre/daily)
JARVIS_PASTA_DAILY=
# Pasta do repositorio que o "git status" pode olhar (ex.: a pasta deste projeto)
JARVIS_PASTA_GIT=

# --- Opcionais ---
# Notas de analise de video, cortes e pacotes
JARVIS_PASTA_DECISOES=
# Robo de cortes: de onde le os videos e onde grava os cortes (pastas diferentes)
JARVIS_CORTES_ENTRADA=
JARVIS_CORTES_SAIDA=
# Caderno de incidentes (Ticket 031)
JARVIS_PASTA_INCIDENTES=
# Guarda do backup 3-2-1 (Ticket 032): pasta da copia no pendrive ou HD externo
JARVIS_BACKUP_OFFLINE=
# Isca / honeytoken (Ticket 034): um token FALSO, diferente do JARVIS_TOKEN, e um arquivo com dados INVENTADOS.
# Quem usar o token falso ou mexer no arquivo dispara o alarme da Sentinela. Nunca ponha dado de verdade aqui.
JARVIS_ISCA_TOKEN=
JARVIS_ISCA_ARQUIVO=

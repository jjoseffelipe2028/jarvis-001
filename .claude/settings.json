{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.key)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(./.claude/**)",
      "Bash(cat .env*)",
      "Bash(type .env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guarda.mjs\""
          }
        ]
      }
    ]
  }
}
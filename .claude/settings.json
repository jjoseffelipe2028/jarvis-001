{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.key)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(./.claude/**)",
      "Bash(cat .env*)",
      "Bash(type .env*)"
    ]
  }
}
